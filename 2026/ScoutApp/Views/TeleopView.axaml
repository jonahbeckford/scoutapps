<UserControl
    x:Class="ScoutApp.Views.TeleopView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="using:ScoutApp.Converter"
    xmlns:vm="using:ScoutApp.ViewModels"
    x:DataType="vm:TeleopViewModel">

    <UserControl.Resources>
        <cvt:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <cvt:EnumMemberValueConverter x:Key="EnumMemberValueConverter" />

        <SolidColorBrush x:Key="black" Color="#000000" />
        <SolidColorBrush x:Key="text" Color="#FFFFFF" />
        <SolidColorBrush x:Key="background" Color="#3D3D3D" />
        <SolidColorBrush x:Key="accent" Color="#F36716" />
        <SolidColorBrush x:Key="lightgrey" Color="#C2C4C3" />
        <SolidColorBrush x:Key="offwhite" Color="#D1CAC3" />
        <SolidColorBrush x:Key="darkgrey" Color="#4D4D4D" />
        <SolidColorBrush x:Key="orange" Color="#FF5722" />
        <SolidColorBrush x:Key="thirdbutton" Color="#DED6CE" />
        <SolidColorBrush x:Key="secondary" Color="#0D6EFD" />
        <SolidColorBrush x:Key="error" Color="#F2110C" />
        <SolidColorBrush x:Key="green" Color="#1FA659" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">

        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Vertical"
            Spacing="32">

            <!--  FUEL  -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <StackPanel Orientation="Vertical" Spacing="10">
                    <RepeatButton
                        Width="200"
                        Height="200"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource darkgrey}"
                        Command="{Binding TeleOpMissedUpCommand}"
                        Content="+"
                        Delay="150"
                        FontSize="40"
                        Foreground="{StaticResource accent}"
                        Interval="75" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{Binding TextSize}"
                        FontWeight="Bold"
                        Text="{Binding TeleOpFuelMissed, StringFormat='MISSED: {0}'}" />
                    <RepeatButton
                        Width="200"
                        Height="200"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource darkgrey}"
                        Command="{Binding TeleOpMissedDownCommand}"
                        Content="-"
                        Delay="150"
                        FontSize="40"
                        Foreground="{StaticResource accent}"
                        Interval="75" />
                </StackPanel>

                <TextBlock
                    Height="32"
                    Margin="60,0,60,0"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold">
                    FUEL
                </TextBlock>

                <StackPanel Orientation="Vertical" Spacing="10">
                    <RepeatButton
                        Width="200"
                        Height="200"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource darkgrey}"
                        Command="{Binding TeleOpScoredUpCommand}"
                        Content="+"
                        Delay="150"
                        FontSize="40"
                        Foreground="{StaticResource accent}"
                        Interval="75" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{Binding TextSize}"
                        FontWeight="Bold"
                        Text="{Binding TeleOpFuelScored, StringFormat='SCORED: {0}'}" />
                    <RepeatButton
                        Width="200"
                        Height="200"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource darkgrey}"
                        Command="{Binding TeleOpScoredDownCommand}"
                        Content="-"
                        Delay="150"
                        FontSize="40"
                        Foreground="{StaticResource accent}"
                        Interval="75" />
                </StackPanel>

            </StackPanel>

            <!--  OBSTACLES  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">

                <TextBlock
                    Height="32"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold">
                    OBSTACLES USED:
                </TextBlock>

                <CheckBox
                    Content="Bump"
                    FontSize="{Binding TextSize}"
                    IsChecked="{Binding TeleOpBump}" />

                <CheckBox
                    Content="Trench"
                    FontSize="{Binding TextSize}"
                    IsChecked="{Binding TeleOpTrench}" />

            </StackPanel>

            <!--  INTAKE  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">

                <TextBlock
                    Height="32"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold">
                    INTAKE FROM:
                </TextBlock>

                <CheckBox
                    Content="Depot"
                    FontSize="{Binding TextSize}"
                    IsChecked="{Binding TeleOpIntakeDepot}" />

                <CheckBox
                    Content="Outpost"
                    FontSize="{Binding TextSize}"
                    IsChecked="{Binding TeleOpIntakeOutpost}" />

                <CheckBox
                    Content="Neutral Zone"
                    FontSize="{Binding TextSize}"
                    IsChecked="{Binding TeleOpIntakeNeutralZone}" />

            </StackPanel>

            <!--  CLIMB  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <TextBlock
                    Height="32"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold">
                    CLIMB:
                </TextBlock>
                <ComboBox Width="225" SelectedItem="{Binding TeleOpClimb, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Items>
                        <x:Static Member="vm:Climb2026.Level1" />
                        <x:Static Member="vm:Climb2026.Level2" />
                        <x:Static Member="vm:Climb2026.Level3" />
                        <x:Static Member="vm:Climb2026.Failed" />
                        <x:Static Member="vm:Climb2026.DidNotAttempt" />
                    </ComboBox.Items>
                </ComboBox>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <TextBlock
                    Height="32"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold"
                    IsVisible="{Binding ShowClimbTimes}">
                    CLIMB TIME:
                </TextBlock>
                <ComboBox
                    Width="225"
                    IsVisible="{Binding ShowClimbTimes}"
                    SelectedItem="{Binding TeleOpClimbTime, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Items>
                        <x:Static Member="vm:ClimbTimes._0to10Seconds" />
                        <x:Static Member="vm:ClimbTimes._10to20Seconds" />
                        <x:Static Member="vm:ClimbTimes._20to30Seconds" />
                        <x:Static Member="vm:ClimbTimes._30PlusSeconds" />
                    </ComboBox.Items>
                </ComboBox>
            </StackPanel>

            <!--  BREAKDOWN  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <TextBlock
                    Height="32"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold">
                    BREAKDOWN:
                </TextBlock>
                <ComboBox Width="225" SelectedItem="{Binding Breakdown, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Items>
                        <x:Static Member="vm:Breakdown2026.None" />
                        <x:Static Member="vm:Breakdown2026.Tipped" />
                        <x:Static Member="vm:Breakdown2026.MechanicalFailure" />
                        <x:Static Member="vm:Breakdown2026.ConnectionFailure" />
                        <x:Static Member="vm:Breakdown2026.Disabled" />
                        <x:Static Member="vm:Breakdown2026.BeachedOnFuel" />
                        <x:Static Member="vm:Breakdown2026.StuckOnBump" />
                    </ComboBox.Items>
                </ComboBox>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding ShowBreakdownTimes}"
                Orientation="Horizontal"
                Spacing="20">
                <TextBlock
                    Height="32"
                    FontSize="{Binding TextSize}"
                    FontWeight="Bold">
                    BREAKDOWN TIME:
                </TextBlock>
                <ComboBox Width="225" SelectedItem="{Binding BreakdownTime, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Items>
                        <x:Static Member="vm:BreakdownTimes._0to15Seconds" />
                        <x:Static Member="vm:BreakdownTimes._15to30Seconds" />
                        <x:Static Member="vm:BreakdownTimes._30PlusSeconds" />
                    </ComboBox.Items>
                </ComboBox>
            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>
