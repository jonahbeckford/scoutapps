                                Content="-"
                                Delay="150"
                                FontSize="40"
                                Foreground="{StaticResource accent}"
                                Interval="75" />
                        </StackPanel>

                        <TextBlock
                            Height="32"
                            Margin="60,0,60,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold">
                            FUEL
                        </TextBlock>

                        <StackPanel Orientation="Vertical">
                            <RepeatButton
                                Width="200"
                                Height="200"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{StaticResource darkgrey}"
                                Command="{Binding TeleOpScoredUpCommand}"
                                Content="+"
                                Delay="150"
                                FontSize="40"
                                Foreground="{StaticResource accent}"
                                Interval="75" />
                            <TextBlock
                                Margin="0,10"
                                HorizontalAlignment="Center"
                                FontSize="{Binding TextSize}"
                                FontWeight="Bold"
                                Text="{Binding TeleOpFuelScored, StringFormat='SCORED: {0}'}" />
                            <RepeatButton
                                Width="200"
                                Height="200"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{StaticResource darkgrey}"
                                Command="{Binding TeleOpScoredDownCommand}"
                                Content="-"
                                Delay="150"
                                FontSize="40"
                                Foreground="{StaticResource accent}"
                                Interval="75" />
                        </StackPanel>

                    </StackPanel>

                    <StackPanel
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            Height="32"
                            Margin="0,0,20,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold">
                            OBSTACLES USED:
                        </TextBlock>

                        <CheckBox
                            Margin="0,0,20,0"
                            Content="Bump"
                            FontSize="{Binding TextSize}"
                            IsChecked="{Binding TeleOpBump}" />

                        <CheckBox
                            Content="Trench"
                            FontSize="{Binding TextSize}"
                            IsChecked="{Binding TeleOpTrench}" />

                    </StackPanel>

                    <StackPanel
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            Height="32"
                            Margin="0,0,20,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold">
                            INTAKE FROM:
                        </TextBlock>

                        <CheckBox
                            Margin="0,0,20,0"
                            Content="Depot"
                            FontSize="{Binding TextSize}"
                            IsChecked="{Binding TeleOpIntakeDepot}" />

                        <CheckBox
                            Margin="0,0,20,0"
                            Content="Outpost"
                            FontSize="{Binding TextSize}"
                            IsChecked="{Binding TeleOpIntakeOutpost}" />

                        <CheckBox
                            Content="Neutral Zone"
                            FontSize="{Binding TextSize}"
                            IsChecked="{Binding TeleOpIntakeNeutralZone}" />

                    </StackPanel>

                    <StackPanel
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Height="32"
                            Margin="0,0,20,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold">
                            CLIMB:
                        </TextBlock>
                        <ComboBox Width="225" SelectedItem="{Binding TeleOpClimb, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Items>
                                <x:Static Member="vm:Climb2026.Level1" />
                                <x:Static Member="vm:Climb2026.Level2" />
                                <x:Static Member="vm:Climb2026.Level3" />
                                <x:Static Member="vm:Climb2026.Failed" />
                                <x:Static Member="vm:Climb2026.DidNotAttempt" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Height="32"
                            Margin="0,0,20,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold"
                            IsVisible="{Binding ShowClimbTimes}">
                            CLIMB TIME:
                        </TextBlock>
                        <ComboBox
                            Width="225"
                            IsVisible="{Binding ShowClimbTimes}"
                            SelectedItem="{Binding TeleOpClimbTime, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Items>
                                <x:Static Member="vm:ClimbTimes._0to10Seconds" />
                                <x:Static Member="vm:ClimbTimes._10to20Seconds" />
                                <x:Static Member="vm:ClimbTimes._20to30Seconds" />
                                <x:Static Member="vm:ClimbTimes._30PlusSeconds" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Height="32"
                            Margin="0,0,20,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold">
                            BREAKDOWN:
                        </TextBlock>
                        <ComboBox Width="225" SelectedItem="{Binding Breakdown, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Items>
                                <x:Static Member="vm:Breakdown2026.None" />
                                <x:Static Member="vm:Breakdown2026.Tipped" />
                                <x:Static Member="vm:Breakdown2026.MechanicalFailure" />
                                <x:Static Member="vm:Breakdown2026.ConnectionFailure" />
                                <x:Static Member="vm:Breakdown2026.Disabled" />
                                <x:Static Member="vm:Breakdown2026.BeachedOnFuel" />
                                <x:Static Member="vm:Breakdown2026.StuckOnBump" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Height="32"
                            Margin="0,0,20,0"
                            FontSize="{Binding TextSize}"
                            FontWeight="Bold"
                            IsVisible="{Binding ShowBreakdownTimes}">
                            BREAKDOWN TIME:
                        </TextBlock>
                        <ComboBox
                            Width="225"
                            IsVisible="{Binding ShowBreakdownTimes}"
                            SelectedItem="{Binding BreakdownTime, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumMemberValueConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Items>
                                <x:Static Member="vm:BreakdownTimes._0to15Seconds" />
                                <x:Static Member="vm:BreakdownTimes._15to30Seconds" />
                                <x:Static Member="vm:BreakdownTimes._30PlusSeconds" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>-->

        </Grid>

    </ScrollViewer>

</UserControl>
